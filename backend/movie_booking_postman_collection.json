{
	"info": {
		"_postman_id": "movie-booking-test-collection",
		"name": "Movie Booking System - Test Collection",
		"description": "Collection kiểm thử API cho hệ thống đặt vé xem phim phục vụ môn Kiểm thử phần mềm",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth - Đăng nhập (Lấy Token)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"var jsonData = pm.response.json();",
							"if (jsonData.data && jsonData.data.token) {",
							"    pm.environment.set(\"jwt_token\", jsonData.data.token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"123456\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/v1/auth/login",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "v1", "auth", "login"]
				}
			}
		},
		{
			"name": "Seats - Lấy danh sách ghế theo suất chiếu",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Verify seat attributes (id, seatNumber, booked, locked)\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data).to.be.an(\"array\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/v1/seats/showtimes/1",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "v1", "seats", "showtimes", "1"]
				}
			}
		},
		{
			"name": "SeatLock - TC01: Giữ ghế thành công (Lock Seats)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"seatIds\": [1],\n    \"showtimeId\": 1,\n    \"userId\": 1\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/v1/seats/lock",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "v1", "seats", "lock"]
				}
			}
		},
		{
			"name": "SeatLock - TC02: Giữ ghế thất bại do người khác đang giữ (400)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 400 Bad Request\", function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"pm.test(\"Response contains error message 'Seat already locked'\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.eql(\"Seat already locked\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"seatIds\": [1],\n    \"showtimeId\": 1,\n    \"userId\": 2\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/v1/seats/lock",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "v1", "seats", "lock"]
				}
			}
		},
		{
			"name": "Booking - TC01: Đặt vé thành công (Book Ticket)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 or 201\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"userId\": 1,\n    \"showtimeId\": 1,\n    \"seatIds\": [1]\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/v1/bookings",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "v1", "bookings"]
				}
			}
		},
		{
			"name": "Booking - TC02: Đặt vé thất bại do ghế đã được mua (400)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 400 Bad Request\", function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"pm.test(\"Response contains message 'Seat is already booked'\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.eql(\"Seat is already booked\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"userId\": 2,\n    \"showtimeId\": 1,\n    \"seatIds\": [1]\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/v1/bookings",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "v1", "bookings"]
				}
			}
		}
	]
}
